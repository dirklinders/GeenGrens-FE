# ──────────────────────────────────────────────────────────
# Muntonrecht FE - environment template
# Copy to .env.local and fill in real values:
#   cp .env.example .env.local
# ──────────────────────────────────────────────────────────

# API base URL (must be HTTPS in dev, see Program.cs cookie config)
NEXT_PUBLIC_API_URL=https://localhost:7424

# "true" enforces auth guards, "false" bypasses them for testing
NEXT_PUBLIC_REQUIRE_AUTH=true
